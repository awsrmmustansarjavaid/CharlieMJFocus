<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pages="clr-namespace:CharlieMJFocus.Presentation.Pages;assembly=CharlieMJFocus.Presentation"
                    xmlns:views="clr-namespace:CharlieMJFocus.App.Views">

    <!--
        Maps each page view-model to its view. The main window shows a ContentControl bound to
        ShellViewModel.CurrentPage, and WPF picks the matching view from this list automatically.
    -->
    <DataTemplate DataType="{x:Type pages:DashboardViewModel}"><views:DashboardView/></DataTemplate>
    <DataTemplate DataType="{x:Type pages:TimerViewModel}"><views:TimerView/></DataTemplate>
    <DataTemplate DataType="{x:Type pages:TasksViewModel}"><views:TasksView/></DataTemplate>
    <DataTemplate DataType="{x:Type pages:PlannerViewModel}"><views:PlannerView/></DataTemplate>
    <DataTemplate DataType="{x:Type pages:StatisticsViewModel}"><views:StatisticsView/></DataTemplate>
    <DataTemplate DataType="{x:Type pages:AppearanceViewModel}"><views:AppearanceView/></DataTemplate>
    <DataTemplate DataType="{x:Type pages:SettingsViewModel}"><views:SettingsView/></DataTemplate>

</ResourceDictionary>
