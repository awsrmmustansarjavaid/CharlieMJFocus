<Application x:Class="CharlieMJFocus.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CharlieMJFocus.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <!--
        No StartupUri: App.xaml.cs builds the services, runs the database migration and then creates
        the main window itself. ShutdownMode is explicit because the app lives in the system tray
        and must keep running when its window is hidden.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
                <ResourceDictionary Source="Resources/Templates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:EqualsConverter x:Key="Equals"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:PriorityBrushConverter x:Key="PriorityBrush"/>
            <conv:HexToBrushConverter x:Key="HexToBrush"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
