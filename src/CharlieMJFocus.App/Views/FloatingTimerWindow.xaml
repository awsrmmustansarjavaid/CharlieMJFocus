<Window x:Class="CharlieMJFocus.App.Views.FloatingTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Charlie MJ Focus timer"
        Width="250" Height="116"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        Foreground="{DynamicResource TextBrush}"
        MouseLeftButtonDown="OnDrag"
        MouseDoubleClick="OnDoubleClick">

    <!-- A small always-on-top timer. Drag it anywhere; double-click to open the main window. -->
    <Border Margin="8" Padding="14,10"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource CardRadius}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding PhaseText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text="{Binding DisplayTime}" FontSize="32" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Width="28" Height="24" Padding="0"
                        Content="&#x2715;" FontFamily="Segoe UI Symbol" FontSize="11"
                        HorizontalAlignment="Right" ToolTip="Hide the floating timer"
                        Click="OnCloseClick"/>
                <Button Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="0,4,0,0"
                        Content="{Binding PrimaryButtonText}"
                        Command="{Binding StartPauseCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
