<Window x:Class="CharlieMJFocus.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Charlie MJ Focus"
        Width="1220" Height="820" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="{DynamicResource BaseFontSize}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0,0,22">
                    <TextBlock Text="&#x25C9;" FontFamily="Segoe UI Symbol" FontSize="22"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppName}" FontSize="18" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Workspace -->
                <TextBlock Grid.Row="1" Text="WORKSPACE" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,6"/>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding WorkspaceItems}" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavButton}"
                                         GroupName="Navigation"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding Key}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" Width="26" FontSize="16"/>
                                    <TextBlock Text="{Binding Title}"/>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Mini timer: always visible, click to open the timer page -->
                <Button Grid.Row="3" Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,0,14"
                        Command="{Binding OpenTimerCommand}" ToolTip="Open the focus timer">
                    <Border Style="{StaticResource Card}" Padding="14,12" Background="{DynamicResource CardAltBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding Timer.PhaseText}" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding Timer.DisplayTime}" FontSize="30" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <TextBlock Text="{Binding Timer.StatusText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Preferences -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="PREFERENCES" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding PreferenceItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource NavButton}"
                                             GroupName="Navigation"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding Key}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" Width="26" FontSize="16"/>
                                        <TextBlock Text="{Binding Title}"/>
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Page content ============ -->
        <!-- The matching view for each page view-model comes from Resources/Templates.xaml. -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False"/>
    </Grid>
</Window>
