<UserControl x:Class="CharlieMJFocus.App.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource PagePadding}">

            <Grid Margin="0,0,0,16">
                <TextBlock Text="Analytics" Style="{StaticResource PageTitle}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Chip}" Content="7 days"
                                 IsChecked="{Binding RangeDays, Converter={StaticResource Equals}, ConverterParameter=7}"/>
                    <RadioButton Style="{StaticResource Chip}" Content="30 days"
                                 IsChecked="{Binding RangeDays, Converter={StaticResource Equals}, ConverterParameter=30}"/>
                    <RadioButton Style="{StaticResource Chip}" Content="90 days"
                                 IsChecked="{Binding RangeDays, Converter={StaticResource Equals}, ConverterParameter=90}"/>
                    <RadioButton Style="{StaticResource Chip}" Content="1 year"
                                 IsChecked="{Binding RangeDays, Converter={StaticResource Equals}, ConverterParameter=365}"/>
                </StackPanel>
            </Grid>

            <!-- Summary cards -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="FOCUS TIME" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalFocus}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="COMPLETED SESSIONS" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Sessions}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="TASKS COMPLETED" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Tasks}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CURRENT STREAK" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Streak}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="AVERAGE SESSION" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Average}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="BEST DAY" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding BestDay}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="BREAK TIME" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalBreak}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="DISTRACTIONS" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Distractions}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Focus chart -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Focus time" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                    <ItemsControl ItemsSource="{Binding Bars}" Height="190">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Tooltip}" Background="Transparent">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" VerticalAlignment="Bottom" Height="{Binding Height}" Margin="2,0"
                                            Background="{DynamicResource AccentBrush}" CornerRadius="3,3,0,0"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center"
                                               Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Categories and export -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Focus by category" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Text}" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </Grid>
                                        <ProgressBar Margin="0,6,0,0" Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="No focus time recorded in this period yet."
                                   Visibility="{Binding HasCategories, Converter={StaticResource InverseBoolToVis}}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Export" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12"
                                   Text="Save every session in the selected period as a CSV file you can open in Excel."/>
                        <Button Content="Export to CSV" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                Command="{Binding ExportCommand}"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,10,0,0" FontSize="12"
                                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
