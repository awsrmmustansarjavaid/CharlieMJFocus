<UserControl x:Class="CharlieMJFocus.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Task list ============ -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="My Tasks" Style="{StaticResource PageTitle}" Margin="0,0,0,14"/>

            <!-- Views -->
            <WrapPanel Grid.Row="1">
                <RadioButton Style="{StaticResource Chip}" Content="Today"
                             IsChecked="{Binding SelectedView, Converter={StaticResource Equals}, ConverterParameter=Today}"/>
                <RadioButton Style="{StaticResource Chip}" Content="Upcoming"
                             IsChecked="{Binding SelectedView, Converter={StaticResource Equals}, ConverterParameter=Upcoming}"/>
                <RadioButton Style="{StaticResource Chip}" Content="Overdue"
                             IsChecked="{Binding SelectedView, Converter={StaticResource Equals}, ConverterParameter=Overdue}"/>
                <RadioButton Style="{StaticResource Chip}" Content="No date"
                             IsChecked="{Binding SelectedView, Converter={StaticResource Equals}, ConverterParameter=Unscheduled}"/>
                <RadioButton Style="{StaticResource Chip}" Content="Completed"
                             IsChecked="{Binding SelectedView, Converter={StaticResource Equals}, ConverterParameter=Completed}"/>
                <RadioButton Style="{StaticResource Chip}" Content="All"
                             IsChecked="{Binding SelectedView, Converter={StaticResource Equals}, ConverterParameter=All}"/>
            </WrapPanel>

            <TextBox Grid.Row="2" Margin="0,4,0,10" ToolTip="Search titles, categories and notes"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <ListBox ItemsSource="{Binding Items}" SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource IconButton}"
                                            Content="{Binding ToggleGlyph}" ToolTip="{Binding ToggleTooltip}"
                                            Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>

                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Opacity" Value="0.55"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Details}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="{DynamicResource PillRadius}" Padding="9,2" Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding PriorityName, Converter={StaticResource PriorityBrush}}">
                                        <TextBlock Text="{Binding PriorityName}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="&#x25B6;" ToolTip="Start focusing on this task"
                                                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.StartFocusCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#x270E;" ToolTip="Edit"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#x2715;" ToolTip="Delete"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="No tasks here. Use the form on the right to add one."
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Add / edit form ============ -->
        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="TITLE" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>

                    <TextBlock Text="NOTES" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="56" MaxHeight="110" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                             ToolTip="For example Development, Learning, Meetings"/>

                    <TextBlock Text="PRIORITY" Style="{StaticResource FieldLabel}"/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Chip}" Content="Low"
                                     IsChecked="{Binding Priority, Converter={StaticResource Equals}, ConverterParameter=Low}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Medium"
                                     IsChecked="{Binding Priority, Converter={StaticResource Equals}, ConverterParameter=Medium}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="High"
                                     IsChecked="{Binding Priority, Converter={StaticResource Equals}, ConverterParameter=High}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Urgent"
                                     IsChecked="{Binding Priority, Converter={StaticResource Equals}, ConverterParameter=Urgent}"/>
                    </WrapPanel>

                    <!-- Time block -->
                    <Separator Margin="0,14,0,0" Background="{DynamicResource LineBrush}"/>
                    <TextBlock Text="SCHEDULE A TIME BLOCK" Style="{StaticResource FieldLabel}"/>

                    <TextBlock Text="Date (yyyy-MM-dd)" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ScheduleDateText, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Today" Padding="10,6" Margin="0,0,4,0"
                                    Command="{Binding QuickDateCommand}" CommandParameter="Schedule|Today"/>
                            <Button Content="Tomorrow" Padding="10,6"
                                    Command="{Binding QuickDateCommand}" CommandParameter="Schedule|Tomorrow"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Start (24h)" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="For example 09:30"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="End (24h)" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="For example 09:55"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Duration shortcuts" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,4"/>
                    <WrapPanel>
                        <Button Content="25 min" Padding="10,5" Margin="0,0,6,6" Command="{Binding SetDurationCommand}" CommandParameter="25"/>
                        <Button Content="30 min" Padding="10,5" Margin="0,0,6,6" Command="{Binding SetDurationCommand}" CommandParameter="30"/>
                        <Button Content="50 min" Padding="10,5" Margin="0,0,6,6" Command="{Binding SetDurationCommand}" CommandParameter="50"/>
                        <Button Content="1 hour" Padding="10,5" Margin="0,0,6,6" Command="{Binding SetDurationCommand}" CommandParameter="60"/>
                        <Button Content="2 hours" Padding="10,5" Margin="0,0,6,6" Command="{Binding SetDurationCommand}" CommandParameter="120"/>
                    </WrapPanel>

                    <TextBlock Text="REMIND ME" Style="{StaticResource FieldLabel}"/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Chip}" Content="Never"
                                     IsChecked="{Binding Reminder, Converter={StaticResource Equals}, ConverterParameter=None}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="At start"
                                     IsChecked="{Binding Reminder, Converter={StaticResource Equals}, ConverterParameter=AtStart}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="5 min before"
                                     IsChecked="{Binding Reminder, Converter={StaticResource Equals}, ConverterParameter=Minutes5}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="15 min before"
                                     IsChecked="{Binding Reminder, Converter={StaticResource Equals}, ConverterParameter=Minutes15}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="30 min before"
                                     IsChecked="{Binding Reminder, Converter={StaticResource Equals}, ConverterParameter=Minutes30}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="1 hour before"
                                     IsChecked="{Binding Reminder, Converter={StaticResource Equals}, ConverterParameter=Hour1}"/>
                    </WrapPanel>

                    <!-- Deadline and repeat -->
                    <Separator Margin="0,8,0,0" Background="{DynamicResource LineBrush}"/>
                    <TextBlock Text="DUE DATE (OPTIONAL)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding DueDateText, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Today" Padding="10,6" Margin="0,0,4,0"
                                    Command="{Binding QuickDateCommand}" CommandParameter="Due|Today"/>
                            <Button Content="Clear" Padding="10,6"
                                    Command="{Binding QuickDateCommand}" CommandParameter="Due|Clear"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="REPEAT" Style="{StaticResource FieldLabel}"/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Chip}" Content="Never"
                                     IsChecked="{Binding Recurrence, Converter={StaticResource Equals}, ConverterParameter=None}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Daily"
                                     IsChecked="{Binding Recurrence, Converter={StaticResource Equals}, ConverterParameter=Daily}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Weekdays"
                                     IsChecked="{Binding Recurrence, Converter={StaticResource Equals}, ConverterParameter=Weekdays}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Weekly"
                                     IsChecked="{Binding Recurrence, Converter={StaticResource Equals}, ConverterParameter=Weekly}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Monthly"
                                     IsChecked="{Binding Recurrence, Converter={StaticResource Equals}, ConverterParameter=Monthly}"/>
                    </WrapPanel>

                    <TextBlock Text="ESTIMATED FOCUS SESSIONS" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding EstimateText, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left"/>

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,4">
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding SaveButtonText}"
                                Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                        <Button Content="Clear form" Command="{Binding NewCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
