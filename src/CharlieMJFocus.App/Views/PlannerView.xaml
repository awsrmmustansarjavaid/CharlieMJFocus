<UserControl x:Class="CharlieMJFocus.App.Views.PlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">

    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Timeline ============ -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Day navigation -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="&#x2039;" FontSize="18" Width="38" Padding="0,2" Margin="0,0,6,0"
                            Command="{Binding PreviousDayCommand}" ToolTip="Previous day"/>
                    <Button Content="&#x203A;" FontSize="18" Width="38" Padding="0,2" Margin="0,0,6,0"
                            Command="{Binding NextDayCommand}" ToolTip="Next day"/>
                    <Button Content="Today" Command="{Binding TodayCommand}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource SectionTitle}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PlannedText}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding FocusText}" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Warnings -->
            <StackPanel Grid.Row="1" Margin="0,10,0,10">
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="{DynamicResource ControlRadius}"
                        Padding="12,8" Margin="0,0,0,6"
                        Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}">
                    <TextBlock Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"
                               Text="{Binding ConflictText}"/>
                </Border>
                <Button Content="Move this day's unfinished tasks to today" HorizontalAlignment="Left" Padding="14,6"
                        Command="{Binding CarryOverCommand}"
                        Visibility="{Binding CanCarryOver, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer x:Name="TimelineScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <!-- 24 hours at 60 px per hour = 1440 px. Geometry comes from PlannerViewModel. -->
                    <Grid Width="{Binding TimelineContentWidth}" Height="{Binding TimelineHeight}" Margin="8,10,8,10">

                        <!-- Hour lines and labels -->
                        <ItemsControl ItemsSource="{Binding HourMarks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="624">
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,-8,0,0" VerticalAlignment="Top"/>
                                        <Border Height="1" Margin="56,0,0,0" VerticalAlignment="Top"
                                                Background="{DynamicResource LineBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Scheduled blocks -->
                        <ItemsControl ItemsSource="{Binding Blocks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding Width}" Height="{Binding Height}" ClipToBounds="True"
                                            CornerRadius="{DynamicResource ControlRadius}" Padding="10,4,4,4"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            BorderThickness="3,0,0,0"
                                            BorderBrush="{Binding PriorityName, Converter={StaticResource PriorityBrush}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Opacity" Value="0.55"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardAltBrush}"/>
                                                        <Setter Property="BorderThickness" Value="3,1,1,1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TimeRange}" FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"
                                                        Content="&#x25B6;" ToolTip="Start focusing"
                                                        Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.FocusBlockCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"
                                                        Content="&#x2713;" ToolTip="Mark done / reopen"
                                                        Command="{Binding DataContext.CompleteBlockCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"
                                                        Content="&#x2715;" ToolTip="Remove from the planner"
                                                        Command="{Binding DataContext.UnscheduleCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Current time -->
                        <Canvas IsHitTestVisible="False" Visibility="{Binding ShowNowLine, Converter={StaticResource BoolToVis}}">
                            <Border Canvas.Top="{Binding NowLineTop}" Canvas.Left="48" Width="576" Height="2"
                                    Background="{DynamicResource DangerBrush}"/>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ Plan a task ============ -->
        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Plan a task" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,8"
                               Text="Pick a task without a time, choose when it starts and how long it takes."/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding Unscheduled}" SelectedItem="{Binding SelectedUnscheduled, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Details}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Every open task already has a time. Nice."
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasUnscheduled, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Start (24h)" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Find free slot" VerticalAlignment="Bottom" Margin="8,0,0,0"
                                Padding="12,8" Command="{Binding FindSlotCommand}"/>
                    </Grid>

                    <TextBlock Text="Duration" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,4"/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Chip}" Content="15m"
                                     IsChecked="{Binding DurationMinutes, Converter={StaticResource Equals}, ConverterParameter=15}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="25m"
                                     IsChecked="{Binding DurationMinutes, Converter={StaticResource Equals}, ConverterParameter=25}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="30m"
                                     IsChecked="{Binding DurationMinutes, Converter={StaticResource Equals}, ConverterParameter=30}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="45m"
                                     IsChecked="{Binding DurationMinutes, Converter={StaticResource Equals}, ConverterParameter=45}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="1h"
                                     IsChecked="{Binding DurationMinutes, Converter={StaticResource Equals}, ConverterParameter=60}"/>
                        <RadioButton Style="{StaticResource Chip}" Content="90m"
                                     IsChecked="{Binding DurationMinutes, Converter={StaticResource Equals}, ConverterParameter=90}"/>
                    </WrapPanel>

                    <Button Style="{StaticResource PrimaryButton}" Content="Add to schedule" Margin="0,6,0,0"
                            HorizontalAlignment="Stretch" Command="{Binding ScheduleCommand}"/>

                    <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
