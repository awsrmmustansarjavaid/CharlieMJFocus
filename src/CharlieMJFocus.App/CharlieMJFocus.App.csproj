<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WPF shell: views, converters, theming and Windows integration. Keep it thin;
       anything that can be tested without a window belongs in the Presentation layer. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The version suffix sets the minimum Windows version (Windows 10 1809). -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms is referenced ONLY for the system-tray NotifyIcon (WPF has none). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF + WinForms together create ambiguous type names, so global usings are switched off here. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Internal file name stays free of spaces (safe for WPF resource URIs and scripts).
         The name users see (file properties, Task Manager, installer) comes from the metadata below. -->
    <AssemblyName>CharlieMJFocus</AssemblyName>
    <AssemblyTitle>Charlie MJ Focus</AssemblyTitle>
    <Description>Charlie MJ Focus: Pomodoro timer, time-based tasks, daily planner and analytics.</Description>
    <Copyright>Copyright (c) 2026 Charlie MJ</Copyright>
    <RootNamespace>CharlieMJFocus.App</RootNamespace>
    <ApplicationIcon>Assets\CharlieMJFocus.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WFAC010 is a WinForms hint about DPI settings in the manifest. This is a WPF app that uses
         WinForms only for the tray icon, and WPF needs the manifest entry for per-monitor DPI. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CharlieMJFocus.Domain\CharlieMJFocus.Domain.csproj" />
    <ProjectReference Include="..\CharlieMJFocus.Application\CharlieMJFocus.Application.csproj" />
    <ProjectReference Include="..\CharlieMJFocus.Presentation\CharlieMJFocus.Presentation.csproj" />
    <ProjectReference Include="..\CharlieMJFocus.Infrastructure\CharlieMJFocus.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the icon and logo load from inside the single-file executable. -->
    <Resource Include="Assets\CharlieMJFocus.ico" />
    <Resource Include="Assets\CharlieMJFocus-Logo-256.png" />
  </ItemGroup>

</Project>
